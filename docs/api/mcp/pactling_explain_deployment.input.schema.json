{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pacticipant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "version"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "latest"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "branch"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "kind",
            "branch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "mainBranch"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "environment"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tag"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ignores": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "pacticipant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "pacticipant"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pacticipant",
    "selector",
    "target"
  ],
  "additionalProperties": false
}
