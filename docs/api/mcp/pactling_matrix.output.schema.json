{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "adapterSchemaVersion": {
          "const": "1.0"
        },
        "data": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "object",
              "properties": {
                "deployable": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "success": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "deployable",
                "reason",
                "success",
                "failed",
                "unknown"
              ]
            },
            "notices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ]
              }
            },
            "matrix": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "consumer": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "type": [
                          "object",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "version"
                    ]
                  },
                  "provider": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "type": [
                          "object",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "version"
                    ]
                  },
                  "pact": {
                    "type": "object"
                  },
                  "verificationResult": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "required": [
                  "consumer",
                  "provider",
                  "pact",
                  "verificationResult"
                ]
              }
            }
          },
          "required": [
            "summary",
            "notices",
            "matrix"
          ]
        },
        "coverage": {
          "const": "recorded_only"
        },
        "evidenceLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rel": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "required": [
              "rel",
              "href"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "adapterSchemaVersion",
        "data",
        "coverage",
        "evidenceLinks"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "adapterSchemaVersion": {
          "const": "1.0"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "httpStatus": {
              "type": "integer"
            },
            "evidenceUrl": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "properties": {
                "reasonCode": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "reasonCode"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "adapterSchemaVersion",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
