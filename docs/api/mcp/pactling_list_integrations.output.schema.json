{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "adapterSchemaVersion": {
          "const": "1.0"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "consumer": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "evidenceLinks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rel": {
                          "type": "string"
                        },
                        "href": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rel",
                        "href"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "consumer",
                  "provider",
                  "evidenceLinks"
                ],
                "additionalProperties": false
              }
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "retrievedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "items",
            "nextCursor",
            "retrievedAt"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "const": "recorded_only"
        },
        "evidenceLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rel": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "required": [
              "rel",
              "href"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "adapterSchemaVersion",
        "data",
        "coverage",
        "evidenceLinks"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "adapterSchemaVersion": {
          "const": "1.0"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "httpStatus": {
              "type": "integer"
            },
            "evidenceUrl": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "properties": {
                "reasonCode": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "reasonCode"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "adapterSchemaVersion",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
